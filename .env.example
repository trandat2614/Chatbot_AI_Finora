GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Alternative OpenAI-compatible provider: FPT AI Factory
# AI_PROVIDER=fpt
# FPT_API_KEY=your_fpt_api_key
# FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
# FPT_CHAT_MODEL=DeepSeek-V4-Flash
# FPT_EMBEDDING_MODEL=Vietnamese_Embedding

KNOWLEDGE_DIR=knowledge
VECTOR_DB_DIR=vector_db
CHROMA_COLLECTION_NAME=finora_knowledge

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
EMBEDDING_BATCH_SIZE=20
EMBEDDING_REQUEST_INTERVAL_SECONDS=15

# AI server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Đặt khóa này ở production; client gửi header X-API-Key
AI_SERVER_API_KEY=change_me_in_production
RATE_LIMIT_PER_MINUTE=30
MAX_HISTORY_MESSAGES=20
MAX_REQUEST_BYTES=1048576
