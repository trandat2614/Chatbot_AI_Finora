GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Alternative OpenAI-compatible provider: FPT AI Factory
# AI_PROVIDER=fpt
# FPT_API_KEY=your_fpt_api_key
# FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
# FPT_CHAT_MODEL=DeepSeek-V4-Flash
# FPT_EMBEDDING_MODEL=Vietnamese_Embedding

KNOWLEDGE_DIR=knowledge
VECTOR_DB_DIR=vector_db
CHROMA_COLLECTION_NAME=finora_knowledge

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
EMBEDDING_BATCH_SIZE=20
EMBEDDING_REQUEST_INTERVAL_SECONDS=15
# Explicit date for trend exports whose filename has day/month but no year.
TREND_IMPORT_DATE=

# LLM response generation
LLM_TEMPERATURE=0.3
ADAPTIVE_RESPONSE_TEMPERATURE=0.6
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# AI server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Legacy compatibility only. Leave empty when ENABLE_LEGACY_API_KEY=false.
AI_SERVER_API_KEY=
RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_HISTORY_MESSAGES=20
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
RAW_UPLOAD_RETENTION_HOURS=24
RAW_UPLOAD_DIR=data/uploads

# Security / multi-tenancy
AUTH_REQUIRED=true
ENVIRONMENT=development
ENABLE_DEMO=true
ENABLE_API_DOCS=true
DEFAULT_TENANT_ID=local-shop
DEFAULT_USER_ID=local-user
DEFAULT_SHOP_ID=default
# Production web-backend authentication (HS256 signed, short-lived token).
WEB_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_chars
WEB_TOKEN_ISSUER=finora-web
WEB_TOKEN_AUDIENCE=finora-ai
WEB_TOKEN_ALGORITHM=HS256
WEB_TOKEN_LEEWAY_SECONDS=15
FINORA_SERVICE_KEY=replace_with_an_independent_random_service_key
# Migration-only. Production should keep this false.
ENABLE_LEGACY_API_KEY=false
# Production: use a random value of at least 32 characters.
PII_HASH_SECRET=replace_with_a_random_secret_at_least_32_chars
# Optional multi-tenant credentials. Identity is derived from the matching key,
# never from tenant_id/user_id/shop_id sent by a frontend.
# TENANT_API_KEYS_JSON=[{"api_key":"secret","tenant_id":"tenant-a","user_id":"user-a","shop_ids":["shop-a"],"role":"analyst"}]
TENANT_DATA_DIR=data/tenants
AUDIT_LOG_FILE=logs/audit.log

# Relational persistence. Direct local runs may use SQLite. Docker/VPS overrides
# this with a PostgreSQL URL.
DATABASE_URL=sqlite:///data/finora.db
AUTO_CREATE_SCHEMA=true
POSTGRES_PASSWORD=replace_with_a_random_database_password
